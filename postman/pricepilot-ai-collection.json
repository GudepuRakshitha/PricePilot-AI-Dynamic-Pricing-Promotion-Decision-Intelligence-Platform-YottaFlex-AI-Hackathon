// ============================================================
// Authentication Flows
// ============================================================

/// Test: Login - Analyst
POST /auth/login
Body:
{
  "email": "{{analyst.username}}",
  "password": "{{analyst.password}}"
}
Auth: No auth
Response: JWT token stored in {{auth.token}}

/// Test: Login - Manager
POST /auth/login
Body:
{
  "email": "{{manager.username}}", 
  "password": "{{manager.password}}"
}
Auth: No auth
Response: JWT token stored in {{auth.token}}

/// Test: Login - Admin
POST /auth/login
Body:
{
  "email": "{{admin.username}}",
  "password": "{{admin.password}}"
}
Auth: No auth
Response: JWT token stored in {{auth.token}}

/// Test: Logout
POST /auth/logout
Auth: Bearer {{auth.token}}
Response: Success message

/// Test: Refresh token
POST /auth/refresh
Auth: Bearer {{auth.token}}
Response: New JWT token


// Pricing Simulation
// ============================================================

/// Test: Run pricing simulation
POST /pricing/simulate
Auth: Bearer {{auth.token}}
Body:
{
  "sku": "SKU-000001",
  "base_price": 1200.00,
  "scenarios": [
    {
      "demand_level": "HIGH",
      "available_stock": 50
    }
  ]
}
Response: Simulation results with recommended prices

/// Test: Get simulation scenarios
GET /pricing/scenarios/SKU-000001
Auth: Bearer {{auth.token}}

// ============================================================
// Pricing Decisions
// ============================================================

/// Test: List decisions
GET /pricing/decisions/
Auth: Bearer {{auth.token}}
Query: status?, sku?, search?

/// Test: Get decision by ID
GET /pricing/decisions/{decision_id}
Auth: Bearer {{auth.token}}

/// Test: Create decision (via pricing engine)
POST /pricing/decisions/
Auth: Bearer {{manager.token}}
Body:
{
  "sku": "SKU-000001",
  "recommended_price": 1250.00,
  "applied_discount": 10.00,
  "demand_level": "STABLE",
  "reason": "Testing decision creation"
}
Response: Created decision object

/// Test: Blocked decision (price below floor)
POST /pricing/decisions/
Auth: Bearer {{manager.token}}
Body:
{
  "sku": "SKU-000001",
  "recommended_price": 500.00,  // Below floor
  "applied_discount": 0.00,
  "demand_level": "STABLE",
  "reason": "Testing below floor"
}
Response: BLOCKED decision with exception

